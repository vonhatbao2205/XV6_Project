--- a/kernel/main.c
+++ b/kernel/main.c
@@ -5,6 +5,7 @@
 #include "defs.h"
 
 volatile static int started = 0;
+extern int ktrace;
 
 // start() jumps here in supervisor mode on all CPUs.
 void
@@ -29,6 +30,7 @@ main()
     fileinit();         // file table
     virtio_disk_init(); // emulated hard disk
     userinit();         // first user process
+    ktrace = 1;
 
     __atomic_store_n(&started, 1, __ATOMIC_RELEASE);
   } else {
diff --git a/kernel/vm.c b/kernel/vm.c
index a3623a5..759c586 100644
--- a/kernel/vm.c
+++ b/kernel/vm.c
@@ -8,6 +8,8 @@
 #include "proc.h"
 #include "fs.h"
 
+extern int ktrace;
+
 /*
  * the kernel's page table.
  */
@@ -258,6 +260,9 @@ uvmalloc(pagetable_t pagetable, uint64 oldsz, uint64 newsz, int xperm)
     return oldsz;
 
   oldsz = PGROUNDUP(oldsz);
+  if (ktrace)
+    printk("KT U %lx %lx %d %s\n", oldsz, newsz, myproc()->pid,
+           myproc()->name);
   for (a = oldsz; a < newsz; a += sz) {
     sz = PGSIZE;
     mem = kalloc();
@@ -273,6 +278,8 @@ uvmalloc(pagetable_t pagetable, uint64 oldsz, uint64 newsz, int xperm)
       uvmdealloc(pagetable, a, oldsz);
       return 0;
     }
+    if (ktrace)
+      printk("KT M %lx %p\n", a, mem);
   }
   return newsz;
 }
